# Absolute path to the local 2024-11 SQLite snapshot. Never commit the database.
HOUSING_DB_PATH=C:\path\to\nearby_housing.db
# Generate a random secret with at least 32 characters. Never expose it to the browser.
HOUSING_API_KEY=replace-with-a-random-secret-at-least-32-characters
HOUSING_ENV=development
HOUSING_RATE_LIMIT_PER_MINUTE=60
HOUSING_MAX_REQUEST_BYTES=16384
