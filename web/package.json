{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:check": "node scripts/validate-migrations.mjs",
    "db:start": "supabase --workdir .. start --output-format text --agent no",
    "db:test": "supabase --workdir .. test db",
    "db:verify-rls": "node scripts/verify-rls.mjs",
    "db:verify-http": "node scripts/verify-postgrest-rls.mjs",
    "auth:verify-local": "node scripts/verify-auth-preferences.mjs",
    "auth:provision-demo-user": "node scripts/provision-demo-auth-user.mjs",
    "feedback:verify-local": "node scripts/verify-live-feedback.mjs",
    "knowledge:verify-worker": "node scripts/verify-knowledge-index-worker.mjs",
    "knowledge:verify-admin-production": "node scripts/verify-admin-production.mjs",
    "deploy:verify": "node scripts/verify-production.mjs",
    "deploy:verify-production": "node scripts/verify-production.mjs --mode=live",
    "deploy:verify-route-logs": "node scripts/verify-route-logs-production.mjs",
    "deploy:verify-incidents": "node scripts/verify-ai-ops-incidents-production.mjs",
    "deploy:verify-model-slos": "node scripts/verify-ai-model-slos-production.mjs",
    "deploy:verify-knowledge-intake": "node scripts/verify-manual-knowledge-intake-production.mjs",
    "knowledge:import-portfolio-production": "node scripts/import-portfolio-knowledge-production.mjs",
    "knowledge:verify-portfolio-production": "node scripts/verify-portfolio-knowledge-production.mjs",
    "external:verify-qwen": "node scripts/verify-qwen.mjs",
    "external:verify-qwen-rerank": "node scripts/verify-qwen-rerank.mjs",
    "external:verify-amap": "node scripts/verify-amap.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "preview:capture": "playwright test --config=playwright.preview.config.ts",
    "interview:record-production": "node scripts/capture-interview-production.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.14.0"
