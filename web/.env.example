# Public application settings
NEXT_PUBLIC_APP_NAME=小智
NEXT_PUBLIC_APP_DESCRIPTION=本地生活 AI 服务助手
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_AI_DEBUG=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_CITY=杭州
NEXT_PUBLIC_DEFAULT_LOCATION_NAME=武林广场
NEXT_PUBLIC_DEFAULT_LONGITUDE=120.163280
NEXT_PUBLIC_DEFAULT_LATITUDE=30.274150

# Optional server-only override for admin traffic (useful for isolated local verification).
SUPABASE_URL=
# Preferred new server-only key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Temporary compatibility only. Do not use a legacy service_role JWT in new deployments.
SUPABASE_SERVICE_ROLE_KEY=
# Explicit opt-in only. When true, failed public business reads visibly use demo data.
SUPABASE_FALLBACK_TO_DEMO=false
# 32+ random characters, used only to sign the HttpOnly anonymous session cookie.
ANONYMOUS_COOKIE_SECRET=
# Production Auth only permits this server-side interview demo email.
AUTH_ALLOWED_EMAIL=

# Alibaba Cloud Model Studio / Qwen, China (Beijing) region
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_RERANK_MODEL=qwen3-rerank
# qwen3-rerank 使用工作空间专属兼容地址，启用重排前必须填写。
DASHSCOPE_RERANK_BASE_URL=

# RAG and agent behavior
RAG_RERANK_ENABLED=false
RAG_VECTOR_WEIGHT=0.65
RAG_TEXT_WEIGHT=0.35
RAG_LOW_CONFIDENCE_THRESHOLD=0.45
RAG_TOP_K=12
RAG_FINAL_K=5
AI_MAX_TOOL_ROUNDS=8
AI_REQUEST_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=8000

# AMap Web Service API (server-only)
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com

# Optional local historical housing HTTP fallback. Never enable it in production.
HOUSING_HTTP_FALLBACK_ENABLED=false
# Configure both URL and key only when the explicit local fallback is enabled.
HOUSING_API_BASE_URL=
HOUSING_API_KEY=
HOUSING_API_TIMEOUT_MS=8000
# WGS84 center used before AMap geocoding is connected.
HOUSING_DEFAULT_CENTER_NAME=武林广场
HOUSING_DEFAULT_LONGITUDE=120.1551
HOUSING_DEFAULT_LATITUDE=30.2741
HOUSING_DEFAULT_RADIUS_M=2000

# Server-only admin token for knowledge review and indexing. Use 32+ random characters.
DEMO_ADMIN_TOKEN=
